%--------------------------------------------------------------------------
% This script reproduces the analysis of the following paper (please cite):
% 
%   Hauke, Rodriguez-Sanchez, Oloye, Berndt, Pinotsis, Friston, Mathalon,
%   & Adams (2026). A Canonical Microcircuit for Estimating Excitation/
%   Inhibition (E/I) Balance. Translational Psychiatry. 
%   https://doi.org/10.1038/s41398-026-04312-y
% 
% This code uses the SPM12 and the TAPAS toolboxes. Please, also cite these
% resources: 
%
% SPM12:
%   Friston et al. (1994). Statistical parametric maps in functional
%   imaging: A general linear approach. Human Brain Mapping.
%   https://doi.org/10.1002/hbm.460020402
%
% TAPAS:
%   Frässle et al. (2021). TAPAS: An Open-Source Software Package for
%   Translational Neuromodeling and Computational Psychiatry. Frontiers in 
%   Psychiatry. https://doi.org/10.3389/fpsyt.2021.680811
%
% TAPAS euler integrator code:
%   Schöbi et al (2021). A fast and robust integrator of delay differential
%   equations in DCM for electrophysiological data. NeuroImage.
%   https://doi.org/10.1016/j.neuroimage.2021.118567 
%
%--------------------------------------------------------------------------


%% Preparation
% Unfortunately, we cannot share the original data, but you can run the
% model using a publicly available data set from Garrido et al. (2007)
% 
%   M.I. Garrido, J.M. Kilner, S.J. Kiebel, K.E. Stephan, K.J. Friston.
%   Dynamic causal modelling of evoked potentials: a reproducibility study.
%   NeuroImage. 2007 Jul 1;36(3):571-80.
% 
% To get this data:
% - go to: https://www.fil.ion.ucl.ac.uk/spm/data/eeg_mmn/
% - download preproccessed MMN data: maeMdfspm8_subject1.zip and unzip 
% - add path to data below


%% Paths
setup_paths;

% Add local paths
[~, uid] = unix('whoami');
switch uid(1: end-1)
    
    % Daniel
    case {'desktop-15ldi1r\pc'}
        result_dir = 'C:\projects\dcm_ei\results\example_ei_model_mmn';
        data_file = 'C:\projects\dcm_ei\data\maeMdfspm8_subject1\maeMdfspm8_subject1.mat';
        prior_file = 'C:\projects\dcm_ei\code\priors\priors_passive_oddball.mat';
        
    otherwise
        warning('Unknown User!')
        warning('Please specify your local paths at the top of the run_model_example.m script.')
end


%% Run MMN example
% This runs the model inversion for the passive oddball (MMN) paradigm.

DCM = fit_mmn_dcm(data_file,result_dir,prior_file);

% To run the model for the paired-click (P50) paradigm and the active 
% oddball (P300) paradigm run:
% - fit_p50_dcm.m 
% - fit_p300_dcm.m
%
% Don't forget to update the condition order in DCM.options.trials
% 
% The prior values from healthy controls reported in the paper can be found
% inside the code/priors folder. For analysis in healthy controls or other
% psychiatric conditions we recommend using these priors. If you are
% interested in priors that were enriched for psychosis risk you can
% download priors for the passive oddball (MMN) and active oddball (P300)
% paradigms from this paper here:
% 
%   Rodriguez-Sanchez*, Hauke*, et al. (2026). Biophysical Modeling of 
%   Excitation/Inhibition Balance and Conversion to Psychosis in the 
%   Clinical High Risk Syndrome. Biological Psychiatry. 
%   https://doi.org/10.1016/j.biopsych.2026.04.007


%% Useful plots
% Plot actual vs predicted response
condition_labels = {'Std','Dev'};
plot_actual_vs_predicted_erp(DCM);

% Plot posterior fit of input to network
t = linspace(DCM.options.Tdcm(1)/1000,DCM.options.Tdcm(2)/1000,1000);
u = spm_erp_u(t,DCM.Ep,DCM.M);
figure; plot(t*1000,u); xlabel('time[ms]'); ylabel('Input strength'); title('Posterior Input Fit');

% Plot posterior parameter estimates
param = {'B_g_ii','B_g_ee'}; 
for p = 1:numel(param)
    plot_dcm_parameters(DCM, param{p});
end
